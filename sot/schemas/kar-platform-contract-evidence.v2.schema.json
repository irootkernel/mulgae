{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kar.local/schemas/kar-platform-contract-evidence.v2.schema.json",
  "title": "KAR Platform Contract Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_oid",
    "platforms",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "kar-platform-contract-evidence.v2"
    },
    "candidate_oid": {
      "$ref": "#/$defs/sha1"
    },
    "platforms": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "prefixItems": [
        {
          "$ref": "#/$defs/linuxAmd64FutureRow"
        },
        {
          "$ref": "#/$defs/linuxArm64FutureRow"
        },
        {
          "$ref": "#/$defs/darwinAmd64FutureRow"
        },
        {
          "$ref": "#/$defs/darwinArm64RequiredRow"
        }
      ],
      "items": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNullReference": {
      "type": "string",
      "minLength": 1,
      "format": "uri-reference"
    },
    "nullableReference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nonNullReference"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_lock_sha256",
        "probe_manifest_sha256",
        "argv_sha256",
        "argv_bundle_sha256",
        "receipt_sha256",
        "evidence_write_manifest_sha256",
        "gate_a2_sha256"
      ],
      "properties": {
        "tool_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "probe_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "argv_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_write_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "gate_a2_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "status",
        "reason",
        "raw_evidence_uri",
        "raw_evidence_sha256",
        "secure_writer_receipt_uri",
        "secure_writer_receipt_sha256"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "enum": [
            "PL-IDENTITY-NATIVE",
            "PL-LOCAL-FS",
            "PL-SAME-DEVICE",
            "PL-PROCESS-GROUP",
            "PL-LOCK-STALE",
            "PL-PERMISSION",
            "PL-SYMLINK",
            "PL-RENAME",
            "PL-FILE-FSYNC",
            "PL-DIR-FSYNC",
            "PL-RECOVERY"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT_RUN"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_evidence_uri": {
          "$ref": "#/$defs/nullableReference"
        },
        "raw_evidence_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "secure_writer_receipt_uri": {
          "$ref": "#/$defs/nullableReference"
        },
        "secure_writer_receipt_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              },
              "raw_evidence_uri": {
                "$ref": "#/$defs/nonNullReference"
              },
              "raw_evidence_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "secure_writer_receipt_uri": {
                "$ref": "#/$defs/nonNullReference"
              },
              "secure_writer_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAIL"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "assertion_failed",
                  "security_violation",
                  "artifact_invalid"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INCONCLUSIVE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "harness_unavailable",
                  "permission_unavailable",
                  "environment_inconclusive"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": "not_run"
              },
              "raw_evidence_uri": {
                "const": null
              },
              "raw_evidence_sha256": {
                "const": null
              },
              "secure_writer_receipt_uri": {
                "const": null
              },
              "secure_writer_receipt_sha256": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "raw_evidence_uri": {
                "type": "null"
              }
            },
            "required": [
              "raw_evidence_uri"
            ]
          },
          "then": {
            "properties": {
              "raw_evidence_sha256": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "raw_evidence_sha256": {
                "type": "null"
              }
            },
            "required": [
              "raw_evidence_sha256"
            ]
          },
          "then": {
            "properties": {
              "raw_evidence_uri": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "secure_writer_receipt_uri": {
                "type": "null"
              }
            },
            "required": [
              "secure_writer_receipt_uri"
            ]
          },
          "then": {
            "properties": {
              "secure_writer_receipt_sha256": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "secure_writer_receipt_sha256": {
                "type": "null"
              }
            },
            "required": [
              "secure_writer_receipt_sha256"
            ]
          },
          "then": {
            "properties": {
              "secure_writer_receipt_uri": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "identityProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-IDENTITY-NATIVE"
            }
          }
        }
      ]
    },
    "localFsProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-LOCAL-FS"
            }
          }
        }
      ]
    },
    "sameDeviceProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-SAME-DEVICE"
            }
          }
        }
      ]
    },
    "processGroupProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-PROCESS-GROUP"
            }
          }
        }
      ]
    },
    "lockStaleProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-LOCK-STALE"
            }
          }
        }
      ]
    },
    "permissionProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-PERMISSION"
            }
          }
        }
      ]
    },
    "symlinkProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-SYMLINK"
            }
          }
        }
      ]
    },
    "renameProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-RENAME"
            }
          }
        }
      ]
    },
    "fileFsyncProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-FILE-FSYNC"
            }
          }
        }
      ]
    },
    "dirFsyncProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-DIR-FSYNC"
            }
          }
        }
      ]
    },
    "recoveryProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PL-RECOVERY"
            }
          }
        }
      ]
    },
    "probes": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {
          "$ref": "#/$defs/identityProbe"
        },
        {
          "$ref": "#/$defs/localFsProbe"
        },
        {
          "$ref": "#/$defs/sameDeviceProbe"
        },
        {
          "$ref": "#/$defs/processGroupProbe"
        },
        {
          "$ref": "#/$defs/lockStaleProbe"
        },
        {
          "$ref": "#/$defs/permissionProbe"
        },
        {
          "$ref": "#/$defs/symlinkProbe"
        },
        {
          "$ref": "#/$defs/renameProbe"
        },
        {
          "$ref": "#/$defs/fileFsyncProbe"
        },
        {
          "$ref": "#/$defs/dirFsyncProbe"
        },
        {
          "$ref": "#/$defs/recoveryProbe"
        }
      ],
      "items": false
    },
    "notRunProbe": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "status": {
              "const": "NOT_RUN"
            },
            "reason": {
              "const": "not_run"
            },
            "raw_evidence_uri": {
              "const": null
            },
            "raw_evidence_sha256": {
              "const": null
            },
            "secure_writer_receipt_uri": {
              "const": null
            },
            "secure_writer_receipt_sha256": {
              "const": null
            }
          }
        }
      ]
    },
    "notRunProbes": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/identityProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/localFsProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/sameDeviceProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/processGroupProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/lockStaleProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/permissionProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/symlinkProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/renameProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/fileFsyncProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/dirFsyncProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/recoveryProbe"
            },
            {
              "$ref": "#/$defs/notRunProbe"
            }
          ]
        }
      ],
      "items": false
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "contract_scope",
        "blocking_for_external_readiness",
        "native_execution",
        "observed_os",
        "observed_arch",
        "filesystem_class",
        "probes",
        "provenance"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "enum": [
            "linux-amd64",
            "linux-arm64",
            "darwin-amd64",
            "darwin-arm64"
          ]
        },
        "contract_scope": {
          "type": "string",
          "enum": [
            "required",
            "intended_future"
          ]
        },
        "blocking_for_external_readiness": {
          "type": "boolean"
        },
        "native_execution": {
          "type": "boolean"
        },
        "observed_os": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "linux",
            "darwin",
            null
          ]
        },
        "observed_arch": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "amd64",
            "arm64",
            null
          ]
        },
        "filesystem_class": {
          "type": "string",
          "enum": [
            "local_posix",
            "remote",
            "unknown"
          ]
        },
        "probes": {
          "$ref": "#/$defs/probes"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "futureRow": {
      "allOf": [
        {
          "$ref": "#/$defs/row"
        },
        {
          "properties": {
            "contract_scope": {
              "const": "intended_future"
            },
            "blocking_for_external_readiness": {
              "const": false
            },
            "native_execution": {
              "const": false
            },
            "observed_os": {
              "const": null
            },
            "observed_arch": {
              "const": null
            },
            "filesystem_class": {
              "const": "unknown"
            },
            "probes": {
              "$ref": "#/$defs/notRunProbes"
            }
          }
        }
      ]
    },
    "linuxAmd64FutureRow": {
      "allOf": [
        {
          "$ref": "#/$defs/futureRow"
        },
        {
          "properties": {
            "cell_id": {
              "const": "linux-amd64"
            }
          }
        }
      ]
    },
    "linuxArm64FutureRow": {
      "allOf": [
        {
          "$ref": "#/$defs/futureRow"
        },
        {
          "properties": {
            "cell_id": {
              "const": "linux-arm64"
            }
          }
        }
      ]
    },
    "darwinAmd64FutureRow": {
      "allOf": [
        {
          "$ref": "#/$defs/futureRow"
        },
        {
          "properties": {
            "cell_id": {
              "const": "darwin-amd64"
            }
          }
        }
      ]
    },
    "darwinArm64RequiredRow": {
      "allOf": [
        {
          "$ref": "#/$defs/row"
        },
        {
          "properties": {
            "cell_id": {
              "const": "darwin-arm64"
            },
            "contract_scope": {
              "const": "required"
            },
            "blocking_for_external_readiness": {
              "const": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "probes": {
                "prefixItems": [
                  {
                    "properties": {
                      "status": {
                        "const": "PASS"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            },
            "required": [
              "probes"
            ]
          },
          "then": {
            "properties": {
              "native_execution": {
                "const": true
              },
              "observed_os": {
                "const": "darwin"
              },
              "observed_arch": {
                "const": "arm64"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probes": {
                "prefixItems": [
                  {
                    "properties": {
                      "status": {
                        "const": "FAIL"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            },
            "required": [
              "probes"
            ]
          },
          "then": {
            "properties": {
              "native_execution": {
                "const": false
              }
            },
            "not": {
              "properties": {
                "observed_os": {
                  "const": "darwin"
                },
                "observed_arch": {
                  "const": "arm64"
                }
              },
              "required": [
                "observed_os",
                "observed_arch"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "probes": {
                "prefixItems": [
                  {
                    "properties": {
                      "status": {
                        "enum": [
                          "INCONCLUSIVE",
                          "NOT_RUN"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            },
            "required": [
              "probes"
            ]
          },
          "then": {
            "properties": {
              "native_execution": {
                "const": false
              },
              "observed_os": {
                "const": null
              },
              "observed_arch": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_execution": {
                "const": true
              }
            },
            "required": [
              "native_execution"
            ]
          },
          "then": {
            "properties": {
              "observed_os": {
                "const": "darwin"
              },
              "observed_arch": {
                "const": "arm64"
              },
              "probes": {
                "prefixItems": [
                  {
                    "properties": {
                      "status": {
                        "const": "PASS"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probes": {
                "prefixItems": [
                  {},
                  {
                    "properties": {
                      "status": {
                        "const": "PASS"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            },
            "required": [
              "probes"
            ]
          },
          "then": {
            "properties": {
              "filesystem_class": {
                "const": "local_posix"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probes": {
                "prefixItems": [
                  {},
                  {
                    "properties": {
                      "status": {
                        "const": "FAIL"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            },
            "required": [
              "probes"
            ]
          },
          "then": {
            "properties": {
              "filesystem_class": {
                "enum": [
                  "remote",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probes": {
                "prefixItems": [
                  {},
                  {
                    "properties": {
                      "status": {
                        "enum": [
                          "INCONCLUSIVE",
                          "NOT_RUN"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            },
            "required": [
              "probes"
            ]
          },
          "then": {
            "properties": {
              "filesystem_class": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "filesystem_class": {
                "const": "local_posix"
              }
            },
            "required": [
              "filesystem_class"
            ]
          },
          "then": {
            "properties": {
              "probes": {
                "prefixItems": [
                  {},
                  {
                    "properties": {
                      "status": {
                        "const": "PASS"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
