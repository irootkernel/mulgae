{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mulgae:schema:provider-followup-output:v1",
  "title": "Mulgae Provider Followup Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "resolution",
    "rationale",
    "evidence",
    "new_findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-provider-followup-output.v1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "resolution": {
      "type": "string",
      "enum": [
        "resolved",
        "partially_resolved",
        "still_open",
        "unclear"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "new_findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "side",
        "line_start",
        "line_end",
        "quote"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "side": {
          "type": "string",
          "enum": [
            "old",
            "new",
            "context",
            "unknown"
          ]
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "description",
        "evidence",
        "recommendation",
        "confidence"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical",
            "blocker"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  }
}
