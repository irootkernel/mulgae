    "trust_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "assertion_count",
        "failure_count",
        "requested_effective_consistent",
        "tainted",
        "ci_proof_eligible",
        "reason_codes"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/check_state"
        },
        "assertion_count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "requested_effective_consistent": {
          "type": "boolean"
        },
        "tainted": {
          "type": "boolean"
        },
        "ci_proof_eligible": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "passed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "failure_count": {
                "const": 0
              },
              "requested_effective_consistent": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "failure_count": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "publication_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "persisted_journal_state",
        "durable_observation_class",
        "derived_publication_status",
        "authority",
        "reason_codes"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/check_state"
        },
        "persisted_journal_state": {
          "type": "string",
          "enum": [
            "collecting",
            "content_validated",
            "final_staged",
            "final_file_installed",
            "manifest_committed",
            "completed"
          ]
        },
        "durable_observation_class": {
          "type": "string",
          "enum": [
            "P2_COMMITTED",
            "P1_INSTALLED",
            "P0_STAGED",
            "P0_NONE",
            "AMBIGUOUS_OR_MISMATCH"
          ]
        },
        "derived_publication_status": {
          "type": "string",
          "enum": [
            "not_published",
            "staged",
            "installed",
            "committed",
            "corrupt"
          ]
        },
        "authority": {
          "type": "string",
          "enum": [
            "none",
            "P0",
            "P1",
            "P2"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "durable_observation_class": {
                "const": "P2_COMMITTED"
              }
            },
            "required": [
              "durable_observation_class"
            ]
          },
          "then": {
            "properties": {
              "derived_publication_status": {
                "const": "committed"
              },
              "authority": {
                "const": "P2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "durable_observation_class": {
                "const": "P1_INSTALLED"
              }
            },
            "required": [
              "durable_observation_class"
            ]
          },
          "then": {
            "properties": {
              "derived_publication_status": {
                "const": "installed"
              },
              "authority": {
                "const": "P1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "durable_observation_class": {
                "const": "P0_STAGED"
              }
            },
            "required": [
              "durable_observation_class"
            ]
          },
          "then": {
            "properties": {
              "derived_publication_status": {
                "const": "staged"
              },
              "authority": {
                "const": "P0"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "durable_observation_class": {
                "const": "P0_NONE"
              }
            },
            "required": [
              "durable_observation_class"
            ]
          },
          "then": {
            "properties": {
              "derived_publication_status": {
                "const": "not_published"
              },
              "authority": {
                "const": "P0"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "durable_observation_class": {
                "const": "AMBIGUOUS_OR_MISMATCH"
              }
            },
            "required": [
              "durable_observation_class"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "failed"
              },
              "derived_publication_status": {
                "const": "corrupt"
              },
              "authority": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
