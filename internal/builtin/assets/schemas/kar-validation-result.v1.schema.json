{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kar:schema:validation-result:v1",
  "title": "KAR Validation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "repair_count",
    "errors",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "kar-validation-result.v1"
    },
    "stage": {
      "type": "string",
      "enum": [
        "parse",
        "schema",
        "semantic",
        "evidence",
        "final"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "repaired_valid",
        "invalid",
        "repair_exhausted",
        "internal_error"
      ]
    },
    "repair_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "errors": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "code",
          "message",
          "repairable"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "repairable": {
            "type": "boolean"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "code",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "evidence_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "verified",
        "partially_verified",
        "unverified",
        "invalid"
      ],
      "properties": {
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "partially_verified": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
