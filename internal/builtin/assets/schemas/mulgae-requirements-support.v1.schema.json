{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-requirements-support.v1.schema.json",
  "title": "Mulgae Requirements Support v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_path",
    "input_sha256",
    "input_byte_length",
    "availability",
    "selected_count",
    "evaluated_count",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-requirements-support.v1"
    },
    "input_path": {
      "const": "requirements/input.json"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_byte_length": {
      "type": "integer",
      "minimum": 1
    },
    "availability": {
      "enum": [
        "not_run",
        "evaluated"
      ]
    },
    "selected_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "evaluated_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/assessment"
      }
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "owner_role",
        "verdict",
        "origin",
        "reason",
        "content_path",
        "content_sha256",
        "content_byte_length"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "owner_role": {
          "enum": [
            "logic",
            "security",
            "maintainability",
            "product",
            "documentation",
            "testing",
            "artist"
          ]
        },
        "verdict": {
          "enum": [
            "met",
            "partially_met",
            "unmet",
            "unverified"
          ]
        },
        "origin": {
          "enum": [
            "provider",
            "mulgae_derived"
          ]
        },
        "reason": {
          "enum": [
            "",
            "insufficient_evidence",
            "extraction_disabled",
            "extraction_allowance_consumed",
            "answer_omitted",
            "invalid_assessment",
            "no_change_target"
          ]
        },
        "content_path": {
          "type": "string",
          "pattern": "^requirements/items/0[0-9]{2}\\.json$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content_byte_length": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "mulgae_derived"
              }
            }
          },
          "then": {
            "properties": {
              "verdict": {
                "const": "unverified"
              },
              "reason": {
                "enum": [
                  "extraction_disabled",
                  "extraction_allowance_consumed",
                  "answer_omitted",
                  "invalid_assessment",
                  "no_change_target"
                ]
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "verdict": {
                  "const": "unverified"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "const": "insufficient_evidence"
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "const": ""
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "const": "not_run"
          }
        }
      },
      "then": {
        "properties": {
          "evaluated_count": {
            "const": 0
          },
          "items": {
            "items": {
              "properties": {
                "origin": {
                  "const": "mulgae_derived"
                },
                "reason": {
                  "const": "no_change_target"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "reason": {
                  "not": {
                    "const": "no_change_target"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
