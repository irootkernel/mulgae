{
  "$defs": {
    "canonical_provider_ids": {
      "oneOf": [
        {
          "maxItems": 0
        },
        {
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "const": "zcode"
            }
          ]
        },
        {
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "const": "grok"
            }
          ]
        },
        {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "zcode"
            },
            {
              "const": "grok"
            }
          ]
        },
        {
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "const": "codex"
            }
          ]
        },
        {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "zcode"
            },
            {
              "const": "codex"
            }
          ]
        },
        {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "grok"
            },
            {
              "const": "codex"
            }
          ]
        },
        {
          "items": false,
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "zcode"
            },
            {
              "const": "grok"
            },
            {
              "const": "codex"
            }
          ]
        }
      ],
      "type": "array"
    },
    "cli_compatibility": {
      "additionalProperties": false,
      "properties": {
        "compatibility": {
          "enum": [
            "verified",
            "newer_than_verified",
            "below_minimum",
            "malformed",
            "not_observed"
          ]
        },
        "eligibility": {
          "enum": [
            "eligible",
            "ineligible",
            "not_evaluated"
          ]
        },
        "minimum_version": {
          "type": "string"
        },
        "observed_version": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "failed",
            "unverifiable",
            "not_applicable"
          ]
        },
        "verified_latest": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "observed_version",
        "eligibility",
        "compatibility",
        "minimum_version",
        "verified_latest",
        "reason_code"
      ],
      "type": "object"
    },
    "diagnostic_check": {
      "additionalProperties": false,
      "properties": {
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/reason_code"
          },
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "verified",
            "failed",
            "unverifiable",
            "not_applicable"
          ]
        }
      },
      "required": [
        "status",
        "reason_codes"
      ],
      "type": "object"
    },
    "not_observed_inventory": {
      "items": false,
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "properties": {
            "family": {
              "const": "zcode"
            },
            "reason": {
              "const": "config_not_ready"
            },
            "state": {
              "const": "not_observed"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "grok"
            },
            "reason": {
              "const": "config_not_ready"
            },
            "state": {
              "const": "not_observed"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "codex"
            },
            "reason": {
              "const": "config_not_ready"
            },
            "state": {
              "const": "not_observed"
            }
          }
        }
      ],
      "type": "array"
    },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "application_compatible": {
          "$ref": "#/$defs/cli_compatibility"
        },
        "binary_available": {
          "$ref": "#/$defs/diagnostic_check"
        },
        "cli_compatible": {
          "$ref": "#/$defs/cli_compatibility"
        },
        "configured": {
          "type": "boolean"
        },
        "family": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "referenced_by_roles": {
          "items": {
            "enum": [
              "logic",
              "security",
              "maintainability",
              "product",
              "documentation",
              "testing",
              "artist"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "eligible",
            "unavailable",
            "not_configured",
            "not_observed"
          ]
        }
      },
      "required": [
        "family",
        "configured",
        "referenced_by_roles",
        "state",
        "reason",
        "binary_available",
        "cli_compatible",
        "application_compatible"
      ],
      "type": "object"
    },
    "provider_codex": {
      "allOf": [
        {
          "$ref": "#/$defs/provider"
        },
        {
          "properties": {
            "family": {
              "const": "codex"
            }
          }
        }
      ]
    },
    "provider_grok": {
      "allOf": [
        {
          "$ref": "#/$defs/provider"
        },
        {
          "properties": {
            "family": {
              "const": "grok"
            }
          }
        }
      ]
    },
    "provider_zcode": {
      "allOf": [
        {
          "$ref": "#/$defs/provider"
        },
        {
          "properties": {
            "family": {
              "const": "zcode"
            }
          }
        }
      ]
    },
    "reason_code": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "type": "string"
    }
  },
  "$id": "https://mulgae.local/schemas/mulgae-doctor-result.v5.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "status": {
                "enum": [
                  "missing",
                  "invalid"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assignment": {
            "properties": {
              "state": {
                "const": "not_observed"
              }
            }
          },
          "configured_provider_ids": {
            "maxItems": 0
          },
          "provider_inventory": {
            "$ref": "#/$defs/not_observed_inventory"
          },
          "readiness": {
            "properties": {
              "state": {
                "const": "unverified"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "status": {
                "enum": [
                  "unsafe",
                  "drifted"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assignment": {
            "properties": {
              "state": {
                "const": "not_observed"
              }
            }
          },
          "configured_provider_ids": {
            "maxItems": 0
          },
          "provider_inventory": {
            "$ref": "#/$defs/not_observed_inventory"
          },
          "readiness": {
            "properties": {
              "state": {
                "const": "unsafe"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "configured_provider_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "assignment": {
              "properties": {
                "state": {
                  "const": "ready"
                }
              }
            },
            "readiness": {
              "properties": {
                "state": {
                  "const": "ready"
                }
              }
            }
          }
        },
        {
          "properties": {
            "assignment": {
              "properties": {
                "state": {
                  "const": "unavailable"
                }
              }
            },
            "readiness": {
              "properties": {
                "state": {
                  "enum": [
                    "unverified",
                    "unsafe"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "assignment": {
              "properties": {
                "state": {
                  "const": "not_observed"
                }
              }
            },
            "readiness": {
              "properties": {
                "state": {
                  "enum": [
                    "unverified",
                    "unsafe"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  ],
  "properties": {
    "assignment": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "resilience": {
              "const": "ready"
            },
            "state": {
              "const": "ready"
            }
          }
        },
        {
          "properties": {
            "resilience": {
              "const": "unavailable"
            },
            "state": {
              "const": "unavailable"
            }
          }
        },
        {
          "properties": {
            "resilience": {
              "const": "not_observed"
            },
            "state": {
              "const": "not_observed"
            }
          }
        }
      ],
      "properties": {
        "resilience": {
          "enum": [
            "ready",
            "unavailable",
            "not_observed"
          ]
        },
        "state": {
          "enum": [
            "ready",
            "unavailable",
            "not_observed"
          ]
        }
      },
      "required": [
        "state",
        "resilience"
      ],
      "type": "object"
    },
    "checked_at": {
      "format": "date-time",
      "type": "string"
    },
    "config": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "locality": {
              "const": "not_observed"
            },
            "reason_codes": {
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "const": "config_missing"
                }
              ]
            },
            "status": {
              "const": "missing"
            }
          }
        },
        {
          "properties": {
            "locality": {
              "const": "verified"
            },
            "reason_codes": {
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "const": "local_config_missing"
                }
              ]
            },
            "status": {
              "const": "missing"
            }
          }
        },
        {
          "properties": {
            "locality": {
              "const": "verified"
            },
            "reason_codes": {
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "enum": [
                    "config_yaml_invalid",
                    "config_size_invalid",
                    "config_provider_timeout_invalid",
                    "config_provider_identity_invalid",
                    "config_role_mapping_invalid",
                    "config_provider_retired"
                  ]
                }
              ]
            },
            "status": {
              "const": "invalid"
            }
          }
        },
        {
          "properties": {
            "locality": {
              "enum": [
                "rejected",
                "verified"
              ]
            },
            "reason_codes": {
              "minItems": 1
            },
            "status": {
              "const": "unsafe"
            }
          }
        },
        {
          "properties": {
            "locality": {
              "const": "drifted"
            },
            "reason_codes": {
              "items": false,
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "const": "config_locality_drifted"
                }
              ]
            },
            "status": {
              "const": "drifted"
            }
          }
        },
        {
          "properties": {
            "locality": {
              "const": "verified"
            },
            "native_home_identity": {
              "const": "verified"
            },
            "provenance_state": {
              "const": "accepted"
            },
            "reason_codes": {
              "maxItems": 0
            },
            "sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "status": {
              "const": "ready"
            }
          }
        }
      ],
      "properties": {
        "authority": {
          "enum": [
            "project_local"
          ]
        },
        "checkout_head_oid": {
          "type": "string"
        },
        "index_entries_sha256": {
          "type": "string"
        },
        "locality": {
          "enum": [
            "not_observed",
            "verified",
            "rejected",
            "drifted"
          ]
        },
        "native_home_identity": {
          "type": "string"
        },
        "provenance_state": {
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/reason_code"
          },
          "maxItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "sha256": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "missing",
            "invalid",
            "unsafe",
            "drifted"
          ]
        },
        "target_commit_oids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "uri": {
          "const": ".mulgae/config.yaml"
        }
      },
      "required": [
        "status",
        "uri",
        "sha256",
        "authority",
        "locality",
        "checkout_head_oid",
        "index_entries_sha256",
        "target_commit_oids",
        "native_home_identity",
        "provenance_state",
        "reason_codes"
      ],
      "type": "object"
    },
    "config_v3": {
      "$ref": "#/$defs/diagnostic_check"
    },
    "configured_provider_ids": {
      "$ref": "#/$defs/canonical_provider_ids"
    },
    "configured_readiness": {
      "$ref": "#/properties/readiness"
    },
    "diagnostics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "configuration",
              "readiness",
              "artifact",
              "security"
            ]
          },
          "code": {
            "$ref": "#/$defs/reason_code"
          },
          "message": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[^\\u0000\\r\\n]+$",
            "type": "string"
          },
          "redacted": {
            "const": true
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "redacted"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "type": "array"
    },
    "local_configuration": {
      "$ref": "#/$defs/diagnostic_check"
    },
    "platform_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cell": {
            "minLength": 1,
            "type": "string"
          },
          "native": {
            "type": "boolean"
          }
        },
        "required": [
          "cell",
          "native"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "project_root_uri": {
      "const": "."
    },
    "provider_identity": {
      "$ref": "#/$defs/diagnostic_check"
    },
    "provider_inventory": {
      "items": false,
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/provider_zcode"
        },
        {
          "$ref": "#/$defs/provider_grok"
        },
        {
          "$ref": "#/$defs/provider_codex"
        }
      ],
      "type": "array"
    },
    "readiness": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "exit_code": {
              "const": 0
            },
            "reason_codes": {
              "maxItems": 0
            },
            "state": {
              "const": "ready"
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 0
            },
            "reason_codes": {
              "minItems": 1
            },
            "state": {
              "const": "degraded"
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 4
            },
            "reason_codes": {
              "minItems": 1
            },
            "state": {
              "const": "unverified"
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "const": 8
            },
            "reason_codes": {
              "minItems": 1
            },
            "state": {
              "const": "unsafe"
            }
          }
        }
      ],
      "properties": {
        "exit_code": {
          "enum": [
            0,
            4,
            8
          ]
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/reason_code"
          },
          "maxItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "ready",
            "degraded",
            "unverified",
            "unsafe"
          ]
        }
      },
      "required": [
        "state",
        "exit_code",
        "reason_codes"
      ],
      "type": "object"
    },
    "role_route_readiness": {
      "$ref": "#/properties/readiness"
    },
    "schema_version": {
      "const": "mulgae-doctor-result.v5"
    },
    "tools_lock": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "not_observed"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "checked_at",
    "project_root_uri",
    "config",
    "config_v3",
    "local_configuration",
    "provider_identity",
    "configured_provider_ids",
    "provider_inventory",
    "assignment",
    "platform_evidence",
    "tools_lock",
    "readiness",
    "configured_readiness",
    "role_route_readiness",
    "diagnostics"
  ],
  "title": "Mulgae Project-local Doctor Result v5",
  "type": "object"
}
