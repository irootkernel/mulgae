{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-requirements-input.v1.schema.json",
  "title": "Mulgae Requirements Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-requirements-input.v1"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "acceptance_criteria",
          "owner_role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[^\\u0000]*$",
              "minLength": 1
            }
          },
          "owner_role": {
            "enum": [
              "logic",
              "security",
              "maintainability",
              "product",
              "documentation",
              "testing",
              "artist"
            ]
          }
        }
      }
    }
  }
}
