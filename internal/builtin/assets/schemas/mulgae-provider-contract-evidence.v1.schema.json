{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-provider-contract-evidence.v1.schema.json",
  "title": "Mulgae Provider Contract Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_oid",
    "gate_a2",
    "runtime_contract",
    "provider",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-provider-contract-evidence.v1"
    },
    "candidate_oid": {
      "$ref": "#/$defs/oid"
    },
    "gate_a2": {
      "$ref": "#/$defs/gate_a2"
    },
    "runtime_contract": {
      "$ref": "#/$defs/runtime_contract"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "nullable_artifact_uri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "gate_a2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "file_sha256",
        "candidate_oid",
        "nonce"
      ],
      "properties": {
        "schema_version": {
          "const": "mulgae-gate-a2.v1"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/evidence/g0/gates/gate-a2\\.json$"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_oid": {
          "$ref": "#/$defs/oid"
        },
        "nonce": {
          "$ref": "#/$defs/nonempty_text"
        }
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "file_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "mulgae-provider-runtime-contract.v1"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/g0/fixtures/provider-runtime-contract\\.v1\\.json$"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "probe_runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "argv_sha256",
        "cwd"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "prefixItems": [
            {
              "const": "/usr/bin/env"
            },
            {
              "const": "python3"
            },
            {
              "type": "string",
              "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/g0/tools/provider_probe\\.py$"
            },
            {
              "const": "run"
            },
            {
              "const": "--family"
            },
            {
              "type": "string",
              "enum": [
                "kimi",
                "zcode",
                "agy"
              ]
            },
            {
              "const": "--probe-manifest"
            },
            {
              "type": "string",
              "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/g0/fixtures/provider-probes\\.json$"
            },
            {
              "const": "--runtime-contract"
            },
            {
              "type": "string",
              "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/g0/fixtures/provider-runtime-contract\\.v1\\.json$"
            },
            {
              "const": "--gate-receipt"
            },
            {
              "type": "string",
              "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/evidence/g0/gates/gate-a2\\.json$"
            }
          ],
          "items": false
        },
        "argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cwd": {
          "const": "REPOSITORY_ROOT"
        }
      }
    },
    "secure_writer_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "path",
        "file_sha256",
        "root_sha256"
      ],
      "properties": {
        "contract": {
          "const": "mulgae-secure-writer/v1"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/evidence/g0/candidates/[0-9a-f]{40}/providers/(?:kimi|zcode|agy)/secure-writer-index\\.json$"
        },
        "file_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "root_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        }
      },
      "oneOf": [
        {
          "properties": {
            "file_sha256": {
              "const": null
            },
            "root_sha256": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "file_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "root_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "status",
        "reason",
        "raw_evidence_uri",
        "raw_evidence_sha256",
        "secure_writer_receipt_uri",
        "secure_writer_receipt_sha256"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "enum": [
            "PV-VERSION",
            "PV-NONINTERACTIVE",
            "PV-PROMPT-TRANSPORT",
            "PV-JSON-ONLY",
            "PV-STDOUT-STDERR",
            "PV-CANCELLATION",
            "PV-OUTPUT-CAP",
            "PV-AUTH-CACHE-CONCURRENCY",
            "PV-EXIT-CLASSIFICATION",
            "PV-CWD-ISOLATION",
            "PV-ROLE-FIT-logic",
            "PV-ROLE-FIT-security",
            "PV-ROLE-FIT-maintainability",
            "PV-ROLE-FIT-product",
            "PV-ROLE-FIT-documentation",
            "PV-ROLE-FIT-testing"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT_RUN"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "raw_evidence_uri": {
          "$ref": "#/$defs/nullable_artifact_uri"
        },
        "raw_evidence_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "secure_writer_receipt_uri": {
          "$ref": "#/$defs/nullable_artifact_uri"
        },
        "secure_writer_receipt_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              },
              "raw_evidence_uri": {
                "type": "string"
              },
              "raw_evidence_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "secure_writer_receipt_uri": {
                "type": "string"
              },
              "secure_writer_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "FAIL",
                  "INCONCLUSIVE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "not_run"
              },
              "raw_evidence_uri": {
                "const": null
              },
              "raw_evidence_sha256": {
                "const": null
              },
              "secure_writer_receipt_uri": {
                "const": null
              },
              "secure_writer_receipt_sha256": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "raw_evidence_uri": {
                "const": null
              }
            }
          },
          "then": {
            "properties": {
              "raw_evidence_sha256": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "raw_evidence_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "secure_writer_receipt_uri": {
                "const": null
              }
            }
          },
          "then": {
            "properties": {
              "secure_writer_receipt_sha256": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "secure_writer_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "pv_version": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-VERSION"
            }
          }
        }
      ]
    },
    "pv_noninteractive": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-NONINTERACTIVE"
            }
          }
        }
      ]
    },
    "pv_prompt_transport": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-PROMPT-TRANSPORT"
            }
          }
        }
      ]
    },
    "pv_json_only": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-JSON-ONLY"
            }
          }
        }
      ]
    },
    "pv_stdio_separation": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-STDOUT-STDERR"
            }
          }
        }
      ]
    },
    "pv_cancellation": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-CANCELLATION"
            }
          }
        }
      ]
    },
    "pv_output_cap": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-OUTPUT-CAP"
            }
          }
        }
      ]
    },
    "pv_auth_cache_concurrency": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-AUTH-CACHE-CONCURRENCY"
            }
          }
        }
      ]
    },
    "pv_exit_classification": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-EXIT-CLASSIFICATION"
            }
          }
        }
      ]
    },
    "pv_cwd_isolation": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-CWD-ISOLATION"
            }
          }
        }
      ]
    },
    "pv_role_fit_logic": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-ROLE-FIT-logic"
            }
          }
        }
      ]
    },
    "pv_role_fit_security": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-ROLE-FIT-security"
            }
          }
        }
      ]
    },
    "pv_role_fit_maintainability": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-ROLE-FIT-maintainability"
            }
          }
        }
      ]
    },
    "pv_role_fit_product": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-ROLE-FIT-product"
            }
          }
        }
      ]
    },
    "pv_role_fit_documentation": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-ROLE-FIT-documentation"
            }
          }
        }
      ]
    },
    "pv_role_fit_testing": {
      "allOf": [
        {
          "$ref": "#/$defs/probe"
        },
        {
          "properties": {
            "probe_id": {
              "const": "PV-ROLE-FIT-testing"
            }
          }
        }
      ]
    },
    "probes": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {
          "$ref": "#/$defs/pv_version"
        },
        {
          "$ref": "#/$defs/pv_noninteractive"
        },
        {
          "$ref": "#/$defs/pv_prompt_transport"
        },
        {
          "$ref": "#/$defs/pv_json_only"
        },
        {
          "$ref": "#/$defs/pv_stdio_separation"
        },
        {
          "$ref": "#/$defs/pv_cancellation"
        },
        {
          "$ref": "#/$defs/pv_output_cap"
        },
        {
          "$ref": "#/$defs/pv_auth_cache_concurrency"
        },
        {
          "$ref": "#/$defs/pv_exit_classification"
        },
        {
          "$ref": "#/$defs/pv_cwd_isolation"
        },
        {
          "$ref": "#/$defs/pv_role_fit_logic"
        },
        {
          "$ref": "#/$defs/pv_role_fit_security"
        },
        {
          "$ref": "#/$defs/pv_role_fit_maintainability"
        },
        {
          "$ref": "#/$defs/pv_role_fit_product"
        },
        {
          "$ref": "#/$defs/pv_role_fit_documentation"
        },
        {
          "$ref": "#/$defs/pv_role_fit_testing"
        }
      ],
      "items": false
    },
    "kimi_tuple_key": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "const": "kimi"
        },
        {
          "const": "local-default"
        },
        {
          "$ref": "#/$defs/nonempty_text"
        },
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": "kimi-default"
        }
      ],
      "items": false
    },
    "zcode_tuple_key": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "const": "zcode"
        },
        {
          "const": "local-default"
        },
        {
          "$ref": "#/$defs/nonempty_text"
        },
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": "zcode-default"
        }
      ],
      "items": false
    },
    "agy_tuple_key": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "const": "agy"
        },
        {
          "const": "local-default"
        },
        {
          "$ref": "#/$defs/nonempty_text"
        },
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": "agy-default"
        }
      ],
      "items": false
    },
    "provider_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "tuple_key",
        "wrapper_argv_sha256",
        "probe_runner",
        "secure_writer_index",
        "probes"
      ],
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "kimi",
            "zcode",
            "agy"
          ]
        },
        "tuple_key": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "wrapper_argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "probe_runner": {
          "$ref": "#/$defs/probe_runner"
        },
        "secure_writer_index": {
          "$ref": "#/$defs/secure_writer_index"
        },
        "probes": {
          "$ref": "#/$defs/probes"
        }
      }
    },
    "kimi_provider": {
      "allOf": [
        {
          "$ref": "#/$defs/provider_base"
        },
        {
          "properties": {
            "family": {
              "const": "kimi"
            },
            "tuple_key": {
              "$ref": "#/$defs/kimi_tuple_key"
            },
            "wrapper_argv_sha256": {
              "const": "c092d46a84dff52a23cf5a08637cf80346a9e6a39adbe3ddac62fbc180950129"
            },
            "probe_runner": {
              "allOf": [
                {
                  "$ref": "#/$defs/probe_runner"
                },
                {
                  "properties": {
                    "argv": {
                      "prefixItems": [
                        true,
                        true,
                        true,
                        true,
                        true,
                        {
                          "const": "kimi"
                        }
                      ]
                    },
                    "argv_sha256": {
                      "const": "c092d46a84dff52a23cf5a08637cf80346a9e6a39adbe3ddac62fbc180950129"
                    }
                  }
                }
              ]
            },
            "secure_writer_index": {
              "allOf": [
                {
                  "$ref": "#/$defs/secure_writer_index"
                },
                {
                  "properties": {
                    "path": {
                      "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/evidence/g0/candidates/[0-9a-f]{40}/providers/kimi/secure-writer-index\\.json$"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "zcode_provider": {
      "allOf": [
        {
          "$ref": "#/$defs/provider_base"
        },
        {
          "properties": {
            "family": {
              "const": "zcode"
            },
            "tuple_key": {
              "$ref": "#/$defs/zcode_tuple_key"
            },
            "wrapper_argv_sha256": {
              "const": "724db2f4e04f01ca6240eae1f5a747ecaf9881696b18ad06cd98c53dd2f5458e"
            },
            "probe_runner": {
              "allOf": [
                {
                  "$ref": "#/$defs/probe_runner"
                },
                {
                  "properties": {
                    "argv": {
                      "prefixItems": [
                        true,
                        true,
                        true,
                        true,
                        true,
                        {
                          "const": "zcode"
                        }
                      ]
                    },
                    "argv_sha256": {
                      "const": "724db2f4e04f01ca6240eae1f5a747ecaf9881696b18ad06cd98c53dd2f5458e"
                    }
                  }
                }
              ]
            },
            "secure_writer_index": {
              "allOf": [
                {
                  "$ref": "#/$defs/secure_writer_index"
                },
                {
                  "properties": {
                    "path": {
                      "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/evidence/g0/candidates/[0-9a-f]{40}/providers/zcode/secure-writer-index\\.json$"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "agy_provider": {
      "allOf": [
        {
          "$ref": "#/$defs/provider_base"
        },
        {
          "properties": {
            "family": {
              "const": "agy"
            },
            "tuple_key": {
              "$ref": "#/$defs/agy_tuple_key"
            },
            "wrapper_argv_sha256": {
              "const": "bbc244436caa277d59ed6785f513f088ad9da292990d5bc6559ceb47eb346520"
            },
            "probe_runner": {
              "allOf": [
                {
                  "$ref": "#/$defs/probe_runner"
                },
                {
                  "properties": {
                    "argv": {
                      "prefixItems": [
                        true,
                        true,
                        true,
                        true,
                        true,
                        {
                          "const": "agy"
                        }
                      ]
                    },
                    "argv_sha256": {
                      "const": "bbc244436caa277d59ed6785f513f088ad9da292990d5bc6559ceb47eb346520"
                    }
                  }
                }
              ]
            },
            "secure_writer_index": {
              "allOf": [
                {
                  "$ref": "#/$defs/secure_writer_index"
                },
                {
                  "properties": {
                    "path": {
                      "pattern": "^\\.gjc/[^\\u0000\\r\\n]+/evidence/g0/candidates/[0-9a-f]{40}/providers/agy/secure-writer-index\\.json$"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "provider": {
      "oneOf": [
        {
          "$ref": "#/$defs/kimi_provider"
        },
        {
          "$ref": "#/$defs/zcode_provider"
        },
        {
          "$ref": "#/$defs/agy_provider"
        }
      ]
    }
  }
}
