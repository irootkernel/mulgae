{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-requirements-cursor.v1.schema.json",
  "title": "Mulgae Requirements Cursor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_binding",
    "publication_receipt",
    "run_id",
    "limit",
    "offset"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-requirements-cursor.v1"
    },
    "project_binding": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publication_receipt": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^r_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    }
  }
}
