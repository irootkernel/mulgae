{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-file-catalog.v1.schema.json",
  "title": "Mulgae File Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-file-catalog.v1"
    },
    "files": {
      "type": "array",
      "minItems": 55,
      "maxItems": 55,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "disposition",
        "media_type",
        "schema_id",
        "pair",
        "consumers",
        "checksum_inclusion",
        "exclusion_reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^sot/(?:[^/\\\\\u0000\\r\\n]+/)*[^/\\\\\u0000\\r\\n]+$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "CHANGED",
            "GENERATED_SELF_EXCLUDED",
            "UNCHANGED_VALIDATED",
            "ADDED"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "pair": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sot/(?:[^/\\\\\u0000\\r\\n]+/)*[^/\\\\\u0000\\r\\n]+$"
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "checksum_inclusion": {
          "type": "boolean"
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "self_excluded_checksum",
            null
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "checksum_inclusion": {
              "const": true
            },
            "exclusion_reason": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "checksum_inclusion": {
              "const": false
            },
            "exclusion_reason": {
              "const": "self_excluded_checksum"
            }
          }
        }
      ]
    }
  }
}
