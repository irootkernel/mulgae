{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-provider-review-wire.v2.schema.json",
  "title": "Mulgae Requirements Review Wire v2",
  "description": "Internal provider-owned requirements review. Sections are validated independently; prose-bearing assessment decoding has no structured-envelope byte ceiling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "completeness",
    "limitations",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-provider-review-output.v3"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "completeness": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "assessments"
      ],
      "properties": {
        "schema_version": {
          "const": "mulgae-provider-requirements.v1"
        },
        "assessments": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement_id",
              "verdict",
              "rationale",
              "evidence",
              "examined_scope",
              "limitations",
              "reason"
            ],
            "properties": {
              "requirement_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "verdict": {
                "enum": [
                  "met",
                  "partially_met",
                  "unmet",
                  "unverified"
                ]
              },
              "rationale": {
                "type": "string",
                "pattern": "^[^\\u0000]*$",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 0,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "current"
                  ],
                  "properties": {
                    "current": {
                      "description": "Provider location claim. Mulgae injects target_sha256 and verification=claimed; the provider must not supply either field.",
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "line_start",
                        "line_end",
                        "side",
                        "quote"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "^(?!/)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\u0000\\r\\n]).+$"
                        },
                        "line_start": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "line_end": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "side": {
                          "type": "string",
                          "enum": [
                            "base",
                            "head",
                            "worktree",
                            "index"
                          ]
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "visual": {
                      "description": "Provider claim against one captured design-spec raster.",
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256",
                        "bbox"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "^(?!/)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\u0000\\r\\n]).+$"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "bbox": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y",
                            "width",
                            "height"
                          ],
                          "properties": {
                            "x": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "y": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "width": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "height": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "examined_scope": {
                "type": "string",
                "pattern": "^[^\\u0000]*$"
              },
              "limitations": {
                "type": "array",
                "minItems": 0,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "pattern": "^[^\\u0000]*$",
                  "minLength": 1
                }
              },
              "reason": {
                "enum": [
                  "",
                  "insufficient_evidence"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "enum": [
                        "met",
                        "partially_met"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "const": "unverified"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reason": {
                      "const": "insufficient_evidence"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "reason": {
                      "const": ""
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "const": "unmet"
                    },
                    "evidence": {
                      "maxItems": 0
                    }
                  }
                },
                "then": {
                  "properties": {
                    "examined_scope": {
                      "minLength": 1
                    },
                    "limitations": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\u0000\\r\\n]).+$"
    },
    "current": {
      "description": "Provider location claim. Mulgae injects target_sha256 and verification=claimed; the provider must not supply either field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line_start",
        "line_end",
        "side",
        "quote"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "type": "string",
          "enum": [
            "base",
            "head",
            "worktree",
            "index"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "visual": {
      "description": "Provider claim against one captured design-spec raster.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bbox"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/current"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "description",
        "evidence",
        "recommendation",
        "confidence"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical",
            "blocker"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  }
}
