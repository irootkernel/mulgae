{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-review-artifact.v1.schema.json",
  "title": "Mulgae Final Review Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "run_id",
    "review_id",
    "run_type",
    "created_at",
    "mulgae",
    "immutable_lineage",
    "target",
    "validation",
    "content_verdict",
    "coverage_status",
    "structured_extraction_status",
    "publication_status",
    "ci_decision",
    "ci_reason_codes",
    "severity_threshold",
    "role_outcomes",
    "findings",
    "limitations",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-review-artifact.v1"
    },
    "session_id": {
      "$ref": "#/$defs/session_id"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "review_id": {
      "$ref": "#/$defs/review_id"
    },
    "run_type": {
      "$ref": "#/$defs/run_type"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mulgae": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "immutable_lineage": {
      "$ref": "#/$defs/immutable_lineage"
    },
    "followup_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/followup_outcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "content_verdict": {
      "$ref": "#/$defs/content_verdict"
    },
    "coverage_status": {
      "$ref": "#/$defs/coverage_status"
    },
    "publication_status": {
      "$ref": "#/$defs/publication_status"
    },
    "ci_decision": {
      "$ref": "#/$defs/ci_decision"
    },
    "ci_reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_code"
      }
    },
    "severity_threshold": {
      "$ref": "#/$defs/severity_threshold"
    },
    "role_outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/role_outcome"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "structured_extraction_status": {
      "$ref": "#/$defs/structured_extraction_status"
    }
  },
  "$defs": {
    "session_id": {
      "type": "string",
      "pattern": "^s_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^r_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^a_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-z0-9:-]+:[0-9a-f]{64}$",
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "enum": [
        "logic",
        "security",
        "maintainability",
        "product",
        "documentation",
        "testing",
        "artist"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "run_type": {
      "type": "string",
      "enum": [
        "review",
        "followup",
        "delta",
        "rerun"
      ]
    },
    "content_verdict": {
      "type": "string",
      "enum": [
        "no_findings",
        "findings_present",
        "request_changes",
        "reports_only"
      ]
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "complete",
        "degraded",
        "incomplete"
      ]
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "not_published",
        "staged",
        "installed",
        "committed",
        "corrupt"
      ]
    },
    "ci_decision": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical",
        "blocker"
      ]
    },
    "immutable_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_run_id",
        "source_run_id",
        "source_review_id",
        "source_finding_ref",
        "replay_mode",
        "lineage_edge_path",
        "lineage_edge_sha256"
      ],
      "properties": {
        "parent_run_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/run_id"
            }
          ]
        },
        "source_run_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/run_id"
            }
          ]
        },
        "source_review_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/review_id"
            }
          ]
        },
        "source_finding_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^F[0-9]{3,}$"
        },
        "replay_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "exact",
            "recompose",
            null
          ]
        },
        "lineage_edge_path": {
          "$ref": "#/$defs/path"
        },
        "lineage_edge_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "manifest_path",
        "base_oid",
        "head_oid"
      ],
      "properties": {
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_path": {
          "$ref": "#/$defs/path"
        },
        "base_oid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "head_oid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "schema_validation",
        "semantic_validation",
        "evidence_validation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "repaired_valid"
          ]
        },
        "schema_validation": {
          "const": "passed"
        },
        "semantic_validation": {
          "const": "passed"
        },
        "evidence_validation": {
          "type": "string",
          "enum": [
            "passed",
            "passed_with_warnings"
          ]
        }
      }
    },
    "severity_threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_changes_at_or_above",
        "policy_source"
      ],
      "properties": {
        "request_changes_at_or_above": {
          "$ref": "#/$defs/severity"
        },
        "policy_source": {
          "const": "project_local"
        }
      }
    },
    "role_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "required",
        "outcome",
        "attempt_id",
        "provider_instance",
        "selected_via",
        "valid_finding_ids",
        "failure_reason",
        "limitations"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "required": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "degraded",
            "failed",
            "not_applicable",
            "skipped"
          ]
        },
        "attempt_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/attempt_id"
            }
          ]
        },
        "provider_instance": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "selected_via": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "primary",
            "fallback",
            null
          ],
          "description": "Which configured route the attempt used. A role is bound to exactly one provider, so new runs only ever record \"primary\"; \"fallback\" is retained so artifacts written before cross-provider fallback was removed stay readable."
        },
        "valid_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^F[0-9]{3,}$"
          }
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "role",
        "provider_instance",
        "severity",
        "title",
        "description",
        "evidence",
        "recommendation",
        "confidence",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{3,}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "provider_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "open",
            "acknowledged",
            "resolved",
            "dismissed"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "current"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source_evidence"
        },
        "current": {
          "$ref": "#/$defs/current_evidence"
        },
        "visual": {
          "$ref": "#/$defs/visual_evidence"
        }
      }
    },
    "visual_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bbox",
        "verification"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "verification": {
          "const": "verified"
        }
      }
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "run_id",
        "review_id",
        "finding_id",
        "source_target_sha256",
        "source_excerpt_sha256"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/session_id"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "review_id": {
          "$ref": "#/$defs/review_id"
        },
        "finding_id": {
          "type": "string",
          "pattern": "^F[0-9]{3,}$"
        },
        "source_target_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_excerpt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "current_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha256",
        "current_excerpt_sha256",
        "side",
        "path",
        "line_start",
        "line_end",
        "quote",
        "verification"
      ],
      "properties": {
        "target_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "current_excerpt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "side": {
          "type": "string",
          "enum": [
            "base",
            "head",
            "worktree",
            "index"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "verification": {
          "type": "string",
          "enum": [
            "claimed",
            "verified",
            "stale",
            "invalid",
            "unverifiable"
          ]
        }
      }
    },
    "followup_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "rationale",
        "evidence"
      ],
      "properties": {
        "resolution": {
          "enum": [
            "resolved",
            "partially_resolved",
            "still_open",
            "unclear"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "production_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_product",
        "build_version",
        "build_commit",
        "objective_sha256",
        "objective_present",
        "snapshot_manifest_sha256",
        "workspace_terminal_receipt",
        "providers"
      ],
      "properties": {
        "build_product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "build_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "build_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "objective_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective_present": {
          "type": "boolean"
        },
        "snapshot_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workspace_terminal_receipt": {
          "$ref": "#/$defs/receipt_id"
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/production_provider"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "objective_present": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "objective_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "else": {
            "properties": {
              "objective_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "production_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "instance",
        "version",
        "executable",
        "executable_sha256",
        "launcher",
        "launcher_sha256",
        "profile_generation",
        "adapter_profile",
        "qualification_receipt_ids",
        "packet_transport_receipt_ids",
        "namespace_terminal_receipt"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "launcher": {
          "type": "string",
          "maxLength": 1024
        },
        "launcher_sha256": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "profile_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "adapter_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "qualification_receipt_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/receipt_id"
          }
        },
        "packet_transport_receipt_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/receipt_id"
          }
        },
        "namespace_terminal_receipt": {
          "$ref": "#/$defs/receipt_id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "launcher": {
                "const": ""
              }
            }
          },
          "then": {
            "properties": {
              "launcher_sha256": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "launcher": {
                "minLength": 1
              },
              "launcher_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation_path",
        "final_validation_path",
        "manifest_path"
      ],
      "properties": {
        "aggregation_path": {
          "$ref": "#/$defs/path"
        },
        "final_validation_path": {
          "$ref": "#/$defs/path"
        },
        "manifest_path": {
          "$ref": "#/$defs/path"
        },
        "production": {
          "$ref": "#/$defs/production_provenance"
        }
      }
    },
    "structured_extraction_status": {
      "type": "string",
      "enum": [
        "structured",
        "mixed",
        "reports_only"
      ]
    }
  }
}
