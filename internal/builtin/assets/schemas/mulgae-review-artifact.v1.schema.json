{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mulgae:schema:review-artifact:v1",
  "title": "Mulgae Final Review Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "run_id",
    "review_id",
    "run_type",
    "created_at",
    "mulgae",
    "lineage",
    "target",
    "validation",
    "coverage",
    "assessment",
    "role_results",
    "findings",
    "followup",
    "limitations",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-review-artifact.v1"
    },
    "session_id": {
      "type": "string",
      "pattern": "^s_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^r_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_type": {
      "type": "string",
      "enum": [
        "review",
        "followup",
        "delta",
        "rerun"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mulgae": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_run_id",
        "source_run_id",
        "source_finding_ref",
        "replay_mode"
      ],
      "properties": {
        "parent_run_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^r_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          ]
        },
        "source_run_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^r_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          ]
        },
        "source_finding_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "replay_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "exact",
            "recompose",
            null
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "content_sha256",
        "previous_content_sha256",
        "base_oid",
        "head_oid",
        "head_tree_oid",
        "index_tree_oid",
        "include_untracked",
        "manifest_path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "git_snapshot",
            "patch",
            "stdin_patch"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "previous_content_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "base_oid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          ]
        },
        "head_oid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          ]
        },
        "head_tree_oid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          ]
        },
        "index_tree_oid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          ]
        },
        "include_untracked": {
          "type": "boolean"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "repair_count",
        "schema_validation",
        "semantic_validation",
        "evidence_validation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "repaired_valid"
          ]
        },
        "repair_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "schema_validation": {
          "const": "passed"
        },
        "semantic_validation": {
          "const": "passed"
        },
        "evidence_validation": {
          "type": "string",
          "enum": [
            "passed",
            "passed_with_warnings"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_roles",
        "required_roles",
        "completed_roles",
        "degraded_roles",
        "missing_roles"
      ],
      "properties": {
        "selected_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "required_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "completed_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "degraded_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "missing_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "summary"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "no_findings",
            "findings_present",
            "request_changes",
            "incomplete"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "role_results": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/role_result"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/final_finding"
      }
    },
    "followup": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_finding_ref",
            "resolution",
            "rationale",
            "evidence",
            "new_finding_ids"
          ],
          "properties": {
            "source_finding_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "resolution": {
              "type": "string",
              "enum": [
                "resolved",
                "partially_resolved",
                "still_open",
                "unclear"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/final_evidence"
              }
            },
            "new_finding_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^F[0-9]{3,}$"
              }
            }
          }
        }
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha256",
        "aggregation_path",
        "final_validation_path"
      ],
      "properties": {
        "target_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "aggregation_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "final_validation_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "$defs": {
    "final_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "side",
        "line_start",
        "line_end",
        "quote",
        "verification",
        "excerpt_ref"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "side": {
          "type": "string",
          "enum": [
            "old",
            "new",
            "context",
            "unknown"
          ]
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "verification": {
          "type": "string",
          "enum": [
            "verified",
            "partially_verified",
            "unverified",
            "invalid_path",
            "invalid_line",
            "quote_mismatch",
            "outside_review_scope"
          ]
        },
        "excerpt_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      }
    },
    "final_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "role",
        "provider_instance",
        "severity",
        "title",
        "description",
        "evidence",
        "recommendation",
        "confidence",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{3,}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "provider_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical",
            "blocker"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/final_evidence"
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "open",
            "acknowledged",
            "resolved",
            "dismissed"
          ]
        }
      }
    },
    "role_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "provider_instance",
        "attempt_id",
        "selected_via",
        "summary",
        "completeness",
        "limitations",
        "validation_status",
        "finding_ids"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "provider_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^a_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "selected_via": {
          "type": "string",
          "enum": [
            "primary",
            "fallback"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "valid",
            "repaired_valid"
          ]
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^F[0-9]{3,}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_type": {
            "const": "followup"
          }
        }
      },
      "then": {
        "properties": {
          "followup": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "followup": {
            "type": "null"
          }
        }
      }
    }
  ]
}
