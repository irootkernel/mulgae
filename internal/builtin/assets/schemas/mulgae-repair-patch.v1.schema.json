{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-repair-patch.v1.schema.json",
  "title": "Mulgae Repair Patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repairs"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-repair-patch.v1"
    },
    "repairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    }
  }
}
