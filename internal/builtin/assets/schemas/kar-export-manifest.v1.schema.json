{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kar.local/schemas/kar-export-manifest.v1.schema.json",
  "title": "KAR Export Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "created_at",
    "immutable_source",
    "source_identity",
    "current_identity",
    "secure_writer",
    "bundle",
    "members"
  ],
  "properties": {
    "schema_version": {
      "const": "kar-export-manifest.v1"
    },
    "export_id": {
      "type": "string",
      "pattern": "^x_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "immutable_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "run_id",
        "review_id",
        "run_manifest_ref",
        "review_artifact_ref"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/sessionId"
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "review_id": {
          "$ref": "#/$defs/reviewId"
        },
        "run_manifest_ref": {
          "$ref": "#/$defs/immutableArtifactRef"
        },
        "review_artifact_ref": {
          "$ref": "#/$defs/immutableArtifactRef"
        }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "run_id",
        "review_id",
        "source_target_sha256"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/sessionId"
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "review_id": {
          "$ref": "#/$defs/reviewId"
        },
        "finding_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"
        },
        "source_target_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_excerpt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["finding_id"] },
              { "required": ["source_excerpt_sha256"] }
            ]
          }
        },
        {
          "required": [
            "finding_id",
            "source_excerpt_sha256"
          ]
        }
      ]
    },
    "current_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha256"
      ],
      "properties": {
        "target_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "current_excerpt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "$ref": "#/$defs/canonicalPath"
        },
        "side": {
          "type": "string",
          "enum": [
            "base",
            "head",
            "worktree",
            "index"
          ]
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "verification": {
          "type": "string",
          "enum": [
            "claimed",
            "verified",
            "stale",
            "invalid",
            "unverifiable"
          ]
        }
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["current_excerpt_sha256"] },
              { "required": ["path"] },
              { "required": ["side"] },
              { "required": ["line_start"] },
              { "required": ["line_end"] },
              { "required": ["verification"] }
            ]
          }
        },
        {
          "required": [
            "current_excerpt_sha256",
            "path",
            "side",
            "line_start",
            "line_end",
            "verification"
          ]
        }
      ]
    },
    "secure_writer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "scan_before_write",
        "redaction_policy",
        "redaction_status",
        "secret_block_evidence",
        "receipt_sha256"
      ],
      "properties": {
        "contract": {
          "const": "kar-secure-writer/v1"
        },
        "scan_before_write": {
          "const": true
        },
        "redaction_policy": {
          "const": "redacted_export"
        },
        "redaction_status": {
          "type": "string",
          "enum": [
            "complete",
            "not_required"
          ]
        },
        "secret_block_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scan_status",
            "on_detection",
            "secret_persisted",
            "blocked_content_hash_persisted"
          ],
          "properties": {
            "scan_status": {
              "const": "clear"
            },
            "on_detection": {
              "const": "abort_export"
            },
            "secret_persisted": {
              "const": false
            },
            "blocked_content_hash_persisted": {
              "const": false
            }
          }
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_count",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "member_count": {
          "type": "integer",
          "minimum": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_path",
          "sha256",
          "size_bytes",
          "media_type",
          "redaction_status"
        ],
        "properties": {
          "member_path": {
            "$ref": "#/$defs/canonicalPath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
          },
          "redaction_status": {
            "type": "string",
            "enum": [
              "applied",
              "not_required"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^s_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^r_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "canonicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "immutableArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "artifact_path": {
          "$ref": "#/$defs/canonicalPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
