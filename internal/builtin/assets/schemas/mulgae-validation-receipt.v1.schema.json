{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-validation-receipt.v1.schema.json",
  "title": "Mulgae Validation Receipt v1",
  "description": "An immutable receipt for one G0 validator invocation. Semantic validation verifies that argv is the exact operation invocation and that every recorded hash resolves to the referenced bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "argv",
    "argv_sha256",
    "validator",
    "fixtures",
    "inputs",
    "status",
    "typed_exit",
    "artifact_refs",
    "assertion_counts",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-validation-receipt.v1"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "argv": {
      "$ref": "#/$defs/argv"
    },
    "argv_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "validator": {
      "$ref": "#/$defs/validator"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "typed_exit": {
      "$ref": "#/$defs/typed_exit"
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "assertion_counts": {
      "$ref": "#/$defs/assertion_counts"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "typed_exit": {
            "$ref": "#/$defs/success_exit"
          },
          "assertion_counts": {
            "properties": {
              "failed": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "typed_exit": {
            "$ref": "#/$defs/non_success_exit"
          },
          "assertion_counts": {
            "properties": {
              "failed": {
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "typed_exit": {
            "$ref": "#/$defs/readiness_exit"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "p0",
        "schema",
        "trace",
        "marker",
        "trust",
        "command",
        "publication",
        "prompt",
        "evidence",
        "cleanup",
        "assignment",
        "integrity",
        "authority",
        "canonical-argv",
        "failure",
        "checksums-generate",
        "checksums-verify"
      ]
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000\\r\\n]+$"
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_path",
        "script_sha256",
        "interpreter_path",
        "interpreter_version",
        "interpreter_sha256"
      ],
      "properties": {
        "script_path": {
          "$ref": "#/$defs/path"
        },
        "script_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "interpreter_path": {
          "$ref": "#/$defs/path"
        },
        "interpreter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "interpreter_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "path",
        "sha256"
      ],
      "properties": {
        "fixture_id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fixture",
            "input",
            "diagnostic",
            "evidence",
            "manifest",
            "index",
            "output"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "typed_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind",
        "reason_codes"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "enum": [
            0,
            4,
            7,
            8,
            10
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "success",
            "readiness",
            "artifact",
            "security",
            "internal"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "code": {
              "const": 0
            },
            "kind": {
              "const": "success"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 4
            },
            "kind": {
              "const": "readiness"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 7
            },
            "kind": {
              "const": "artifact"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 8
            },
            "kind": {
              "const": "security"
            }
          }
        },
        {
          "properties": {
            "code": {
              "const": 10
            },
            "kind": {
              "const": "internal"
            }
          }
        }
      ]
    },
    "success_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind",
        "reason_codes"
      ],
      "properties": {
        "code": {
          "const": 0
        },
        "kind": {
          "const": "success"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      }
    },
    "non_success_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind",
        "reason_codes"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "enum": [
            4,
            7,
            8,
            10
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "readiness",
            "artifact",
            "security",
            "internal"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/typed_exit"
        }
      ]
    },
    "readiness_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind",
        "reason_codes"
      ],
      "properties": {
        "code": {
          "const": 4
        },
        "kind": {
          "const": "readiness"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      }
    },
    "assertion_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
