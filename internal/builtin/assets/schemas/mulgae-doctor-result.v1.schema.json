{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulgae.local/schemas/mulgae-doctor-result.v1.schema.json",
  "title": "Mulgae Doctor Result v1",
  "description": "A redacted environment diagnosis. Intended providers remain unverified until complete provider and native-platform evidence is recorded; that readiness state exits 4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checked_at",
    "project_root",
    "intended_provider_ids",
    "unverified_provider_ids",
    "provider_evidence",
    "platform_evidence",
    "tools_lock",
    "readiness",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "mulgae-doctor-result.v1"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_root": {
      "$ref": "#/$defs/path"
    },
    "intended_provider_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/provider_id"
      }
    },
    "unverified_provider_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/provider_id"
      }
    },
    "provider_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/provider_evidence"
      }
    },
    "platform_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/platform_evidence"
      }
    },
    "tools_lock": {
      "$ref": "#/$defs/tools_lock"
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "readiness": {
            "properties": {
              "state": {
                "const": "ready"
              }
            },
            "required": ["state"]
          }
        },
        "required": ["readiness"]
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readiness": {
            "properties": {
              "state": {
                "const": "unverified"
              }
            },
            "required": ["state"]
          }
        },
        "required": ["readiness"]
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "exit_code": {
                "const": 4
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "provider_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "intended",
        "assignment_state",
        "evidence_state",
        "evidence_uri",
        "evidence_sha256",
        "reason_codes"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/provider_id"
        },
        "intended": {
          "type": "boolean"
        },
        "assignment_state": {
          "type": "string",
          "enum": ["intended_but_unverified", "eligible", "ineligible"]
        },
        "evidence_state": {
          "type": "string",
          "enum": ["pass", "inconclusive", "fail", "unverified"]
        },
        "evidence_uri": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "evidence_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assignment_state": {
                "const": "intended_but_unverified"
              }
            },
            "required": ["assignment_state"]
          },
          "then": {
            "properties": {
              "intended": { "const": true },
              "evidence_state": { "const": "unverified" },
              "evidence_uri": { "const": null },
              "evidence_sha256": { "const": null },
              "reason_codes": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "pass"
              }
            },
            "required": ["evidence_state"]
          },
          "then": {
            "properties": {
              "evidence_uri": { "$ref": "#/$defs/uri" },
              "evidence_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "platform_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "native",
        "evidence_state",
        "evidence_uri",
        "evidence_sha256",
        "reason_codes"
      ],
      "properties": {
        "cell": {
          "type": "string",
          "enum": ["linux-amd64", "linux-arm64", "darwin-amd64", "darwin-arm64"]
        },
        "native": {
          "type": "boolean"
        },
        "evidence_state": {
          "type": "string",
          "enum": ["pass", "inconclusive", "fail", "unverified"]
        },
        "evidence_uri": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "evidence_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "pass"
              }
            },
            "required": ["evidence_state"]
          },
          "then": {
            "properties": {
              "native": { "const": true },
              "evidence_uri": { "$ref": "#/$defs/uri" },
              "evidence_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "unverified"
              }
            },
            "required": ["evidence_state"]
          },
          "then": {
            "properties": {
              "evidence_uri": { "const": null },
              "evidence_sha256": { "const": null },
              "reason_codes": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "tools_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "uri", "sha256", "tools"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["locked", "missing", "mismatch"]
        },
        "uri": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tool"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "locked"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "uri": { "$ref": "#/$defs/uri" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "tools": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "missing"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "uri": { "const": null },
              "sha256": { "const": null },
              "tools": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "resolved_path", "version", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["python3", "git"]
        },
        "resolved_path": {
          "$ref": "#/$defs/path"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "exit_code", "reason_codes"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["ready", "unverified"]
        },
        "exit_code": {
          "type": "integer",
          "enum": [0, 4]
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason_code"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "message",
        "redacted",
        "credential_bytes_persisted",
        "artifact_uri"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/reason_code"
        },
        "category": {
          "type": "string",
          "enum": ["configuration", "readiness", "artifact", "security"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "redacted": {
          "const": true
        },
        "credential_bytes_persisted": {
          "const": false
        },
        "artifact_uri": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]+$"
        }
      }
    }
  }
}
