              },
              "raw_evidence_uri": {
                "type": "string"
              },
              "reason": {
                "const": null
              },
              "secure_writer_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "secure_writer_receipt_uri": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "FAIL",
                  "INCONCLUSIVE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          },
          "then": {
            "properties": {
              "raw_evidence_sha256": {
                "const": null
              },
              "raw_evidence_uri": {
                "const": null
              },
              "reason": {
                "const": "not_run"
              },
              "secure_writer_receipt_sha256": {
                "const": null
              },
              "secure_writer_receipt_uri": {
                "const": null
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "raw_evidence_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "if": {
            "properties": {
              "raw_evidence_uri": {
                "const": null
              }
            }
          },
          "then": {
            "properties": {
              "raw_evidence_sha256": {
                "const": null
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "secure_writer_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "if": {
            "properties": {
              "secure_writer_receipt_uri": {
                "const": null
              }
            }
          },
          "then": {
            "properties": {
              "secure_writer_receipt_sha256": {
                "const": null
              }
            }
          }
